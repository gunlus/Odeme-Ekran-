<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:Odeme_Projesi.Models"
        mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
        x:Class="Odeme_Projesi.MainWindow"
        Title="Ödeme Ekranı">

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- 0: Başlık -->
            <RowDefinition Height="20"/>   <!-- 1: Boşluk -->
            <RowDefinition Height="Auto"/> <!-- 2: Arama -->
            <RowDefinition Height="Auto"/> <!-- 3: Hesap Seç (otomatik yükseklik) -->
            <RowDefinition Height="Auto"/> <!-- 4: Boşluk (yeni) -->
            <RowDefinition Height="*"/>    <!-- 5: Liste (kalan alan) -->
        </Grid.RowDefinitions>

        <!-- BAŞLIK -->
        <TextBlock Grid.Row="0" 
                   Text="Ödeme Ekranı" 
                   FontSize="28" 
                   FontWeight="Bold" 
                   Foreground="#2C3E50"
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center"/>

        <!-- ARAMA -->
        <StackPanel Grid.Row="2" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top">
            <TextBox x:Name="TxtAramaBari"
                     PlaceholderText="TC Kimlik No Giriniz" 
                     Width="400" 
                     Height="40"
                     FontSize="14"
                     VerticalContentAlignment="Center"/>

            <Button Content="  Sorgula" 
                    Click="Sorgula_Click"
                    Background="#3498DB" 
                    Foreground="White" 
                    Width="110" 
                    Height="40"
                    Margin="10,0,0,0"
                    FontSize="18"
                    FontWeight="SemiBold"/>

            <Button Content="  Temizle" 
                    Click="Temizle_Click"
                    Background="#7F8C8D" 
                    Foreground="White" 
                    Width="110" 
                    Height="40"
                    Margin="10,0,0,0"
                    FontSize="18"
                    FontWeight="SemiBold"/>
        </StackPanel>

        <!-- HESAP SEÇİMİ -->
        <StackPanel Grid.Row="3" 
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Width="835"
                    Margin="0,10,0,0">
            <TextBlock Text="Hesap Seçin:" 
                       VerticalAlignment="Center"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Margin="0,0,10,0"/>
            <ComboBox x:Name="CmbHesaplar"
                      Width="250"
                      Height="35"
                      FontSize="14"
                      SelectionChanged="CmbHesaplar_SelectionChanged"
                      IsEnabled="False">
                <ComboBox.ItemTemplate>
                    <DataTemplate DataType="models:Hesap">
                        <TextBlock Text="{Binding Path=HesapNo}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <!-- BOŞLUK SATIRI (Hesap seçimi ile liste arasında) -->
        <Grid Grid.Row="4" Height="15" />

        <!-- LİSTE ALANI -->
        <StackPanel Grid.Row="5" 
                    VerticalAlignment="Stretch"
                    HorizontalAlignment="Stretch">

            <!-- Tablo Başlığı -->
            <Border Background="#34495E" 
                    Padding="10,8" 
                    CornerRadius="6,6,0,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="160"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="130"/>
                        <ColumnDefinition Width="150"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Ödeme No" Foreground="White" FontWeight="Bold" Grid.Column="0" HorizontalAlignment="Left"/>
                    <TextBlock Text="Hesap No" Foreground="White" FontWeight="Bold" Grid.Column="1" HorizontalAlignment="Left"/>
                    <TextBlock Text="Açıklama" Foreground="White" FontWeight="Bold" Grid.Column="2" HorizontalAlignment="Left" Margin="10,0,0,0"/>
                    <TextBlock Text="Borç Miktarı" Foreground="White" FontWeight="Bold" Grid.Column="3" HorizontalAlignment="Right" Margin="0,0,15,0"/>
                    <TextBlock Text="Son Ödeme Tarihi" Foreground="White" FontWeight="Bold" Grid.Column="4" HorizontalAlignment="Center"/>
                </Grid>
            </Border>

            <!-- Ödeme Listesi -->
            <ListBox x:Name="LstBorclar" 
                     BorderThickness="0"
                     MinHeight="250"
                     Background="White"
                     Padding="0">
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Padding" Value="0"/>
                        <Setter Property="Margin" Value="0"/>
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="models:Odeme">
                        <Border BorderBrush="#E0E0E0" 
                                BorderThickness="0,0,0,1" 
                                Padding="10,8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="160"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="130"/>
                                    <ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                
                                <TextBlock Text="{Binding Id}" 
                                           Grid.Column="0" 
                                           FontWeight="Bold"
                                           HorizontalAlignment="Left"/>
                                
                                <TextBlock Text="{Binding AlacakliHesap.HesapNo}" 
                                           Grid.Column="1" 
                                           FontWeight="SemiBold"
                                           Foreground="#2980B9"
                                           HorizontalAlignment="Left"/>
                                
                                <TextBlock Text="{Binding OdemeAciklamasi}" 
                                           Grid.Column="2" 
                                           HorizontalAlignment="Left"
                                           Margin="10,0,0,0"/>
                                
                                <TextBlock Text="{Binding OdemeMiktari, StringFormat={}{0:C}}" 
                                           Grid.Column="3" 
                                           HorizontalAlignment="Right" 
                                           Foreground="#E67E22"
                                           Margin="0,0,15,0"/>
                                
                                <TextBlock Text="{Binding SonOdemeTarihi, StringFormat={}{0:dd.MM.yyyy}}" 
                                           Grid.Column="4" 
                                           HorizontalAlignment="Center"/>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Öde Butonu -->
            <Button x:Name="BtnOdemeYap" 
                    Content="Seçili Ödemeyi Gerçekleştir"
                    Click="OdemeYap_Click"
                    Background="#27AE60"
                    Foreground="White"
                    Padding="10"
                    Margin="0,10,0,0"
                    HorizontalAlignment="Center"
                    FontWeight="SemiBold"
                    IsVisible="False"/> 
        </StackPanel>

    </Grid>
</Window>